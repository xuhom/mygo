plugins { id 'com.android.application' }
android {
    namespace 'dev.mygo.host'
    compileSdk 36
    defaultConfig {
        applicationId {{quote .Identifier}}
        minSdk 26
        targetSdk 36
        versionCode 1
        versionName {{quote .Version}}
    }
    compileOptions {
        sourceCompatibility JavaVersion.VERSION_17
        targetCompatibility JavaVersion.VERSION_17
    }
}
